<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="Infinity" maxWidth="Infinity"
      spacing="18" style="-fx-background-color: white; -fx-padding: 30 40 40 40;"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bookingapp.controller.user.Info">

    <!-- Tiêu đề -->
    <Label text="Thông tin tài khoản" alignment="CENTER"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
        <padding>
            <Insets bottom="20"/>
        </padding>
    </Label>

    <!-- Dòng Tên tài khoản -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Tên tài khoản:" minWidth="120" prefWidth="120"/>
        <TextField fx:id="txtUsername" editable="false" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Dòng Mật khẩu -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Mật khẩu:" minWidth="120" prefWidth="120"/>
        <TextField fx:id="txtPassword" editable="false" promptText="••••••••" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Dòng Tên đầy đủ -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Tên đầy đủ:" minWidth="120" prefWidth="120"/>
        <TextField fx:id="txtFullname" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Dòng Số điện thoại -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Số điện thoại:" minWidth="120" prefWidth="120"/>
        <TextField fx:id="txtNumberPhone" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Hai nút căn giữa đẹp -->
    <HBox alignment="CENTER" spacing="20" prefHeight="50">
        <Button fx:id="btnChangePassword" text="Đổi mật khẩu"
                prefWidth="140" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button fx:id="btnChangeInfo" text="Cập nhật thông tin"
                prefWidth="160" onAction="#updateInfo"
                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

</VBox>