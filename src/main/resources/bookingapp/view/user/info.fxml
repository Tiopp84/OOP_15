<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="Infinity" maxWidth="Infinity"
      spacing="32" alignment="CENTER"
      style="-fx-background-color: #f8f9fa;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bookingapp.controller.user.Info">

    <Label text="Thông tin tài khoản"
           alignment="CENTER"
           style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #2c3e50;">
        <padding><Insets bottom="20"/></padding>
    </Label>

    <VBox spacing="20" maxWidth="580"
          style="-fx-background-color: white; -fx-background-radius: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 8);
                 -fx-padding: 40;">

        <!-- Tên tài khoản -->
        <GridPane hgap="24" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="35"/>
                <ColumnConstraints percentWidth="65"/>
            </columnConstraints>
            <Label text="Tên tài khoản" style="-fx-font-size: 15px; -fx-text-fill: #636e72; -fx-font-weight: bold;" GridPane.columnIndex="0"/>
            <Label fx:id="lblUsername" text="Chưa tải dữ liệu"
                   style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #1e272e;
                          -fx-background-color: #e9ecef; -fx-background-radius: 16;
                          -fx-padding: 14 32 14 28; -fx-border-radius: 16;
                          -fx-border-color: #ced4da; -fx-border-width: 1.5;"
                   alignment="CENTER_LEFT" GridPane.columnIndex="1"
                   maxWidth="Infinity" GridPane.hgrow="ALWAYS"/>
        </GridPane>

        <!-- Tên đầy đủ -->
        <GridPane hgap="24" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="35"/>
                <ColumnConstraints percentWidth="65"/>
            </columnConstraints>
            <Label text="Tên đầy đủ" style="-fx-font-size: 15px; -fx-text-fill: #636e72; -fx-font-weight: bold;" GridPane.columnIndex="0"/>
            <Label fx:id="lblFullname" text="Chưa tải dữ liệu"
                   style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #1e272e;
                          -fx-background-color: #e9ecef; -fx-background-radius: 16;
                          -fx-padding: 14 32 14 28; -fx-border-radius: 16;
                          -fx-border-color: #ced4da; -fx-border-width: 1.5;"
                   alignment="CENTER_LEFT" GridPane.columnIndex="1"
                   maxWidth="Infinity" GridPane.hgrow="ALWAYS"/>
        </GridPane>

        <!-- Số điện thoại -->
        <GridPane hgap="24" vgap="16">
            <columnConstraints>
                <ColumnConstraints percentWidth="35"/>
                <ColumnConstraints percentWidth="65"/>
            </columnConstraints>
            <Label text="Số điện thoại" style="-fx-font-size: 15px; -fx-text-fill: #636e72; -fx-font-weight: bold;" GridPane.columnIndex="0"/>
            <Label fx:id="lblNumberPhone" text="Chưa tải dữ liệu"
                   style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #1e272e;
                          -fx-background-color: #e9ecef; -fx-background-radius: 16;
                          -fx-padding: 14 32 14 28; -fx-border-radius: 16;
                          -fx-border-color: #ced4da; -fx-border-width: 1.5;"
                   alignment="CENTER_LEFT" GridPane.columnIndex="1"
                   maxWidth="Infinity" GridPane.hgrow="ALWAYS"/>
        </GridPane>

        <!-- Hai nút ĐẸP - DÀI - ĐỀU - HIỆN ĐỦ CHỮ -->
        <HBox alignment="CENTER" spacing="24" style="-fx-padding: 30 0 0 0;">
            <Button fx:id="btnChangePassword"
                    text="Đổi mật khẩu"
                    minWidth="180" prefWidth="180" maxWidth="180"
                    prefHeight="56"
                    style="-fx-background-color: #f39c12; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 16px;
                           -fx-background-radius: 16; -fx-cursor: hand;"
                    onAction="#changePass"/>

            <Button fx:id="btnChangeInfo"
                    text="Cập nhật thông tin"
                    minWidth="240" prefWidth="240" maxWidth="240"
                    prefHeight="56"
                    style="-fx-background-color: #e67e22; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 16px;
                           -fx-background-radius: 16; -fx-cursor: hand;"
                    onAction="#updateInfo"/>
        </HBox>

    </VBox>
</VBox>