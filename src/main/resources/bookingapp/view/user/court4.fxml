<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="600.0" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bookingapp.controller.user.Court4">
    <children>
        <VBox alignment="CENTER" prefHeight="117.0" prefWidth="600.0" style="-fx-background-color: #e8fff5;">
            <children>
                <HBox alignment="CENTER" prefHeight="50.0" prefWidth="600.0">
                    <children>
                        <Label fx:id="lb_header" text="Đặt lịch sân 1">
                            <font>
                                <Font name="System Italic" size="20.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" layoutX="10.0" layoutY="10.0" prefHeight="50.0" prefWidth="600.0">
                    <children>
                        <DatePicker fx:id="fld_date" promptText="date" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="60.0" prefHeight="58.0" prefWidth="600.0" spacing="20.0">
                    <children>
                        <Label lineSpacing="10.0" style="-fx-background-color: #ffffff;" text="   Trống    ">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                        <Label lineSpacing="10.0" style="-fx-background-color: #ff6d6d;" text="    Đã đặt     ">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                        <Label lineSpacing="10.0" style="-fx-background-color: #a8a8a8;" text="      Khóa     ">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
