<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="28"
      style="-fx-background-color: white;
             -fx-background-radius: 16;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 20, 0, 0, 5);"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bookingapp.controller.user.UpdateInfo"
        stylesheets="@../../assets/style.css">

    <padding>
        <Insets top="35" right="50" bottom="40" left="50"/>
    </padding>

    <!-- Tiêu đề -->
    <Label text="Cập nhật thông tin cá nhân"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2d3436;"/>

    <!-- Form -->
    <VBox spacing="20" maxWidth="380">

        <VBox spacing="7">
            <Label text="Tên đầy đủ" styleClass="field-label"/>
            <TextField fx:id="txtFullname" promptText="VD: Nguyễn Văn A" styleClass="text-field"/>
        </VBox>

        <VBox spacing="7">
            <Label text="Số điện thoại" styleClass="field-label"/>
            <TextField fx:id="txtPhone" promptText="VD: 0901234567" styleClass="text-field"/>
        </VBox>

    </VBox>

    <!-- Chỉ 1 nút Lưu – căn giữa đẹp -->
    <Button text="Lưu thay đổi"
            onAction="#onSave"
            styleClass="btn-save-single"/>

    <!-- CSS -->
</VBox>