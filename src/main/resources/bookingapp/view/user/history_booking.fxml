<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: #f9f9f9;" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bookingapp.controller.user.HistoryBooking">

    <padding>
        <Insets bottom="30" left="40" right="40" top="30" />
    </padding>

    <!-- Tiêu đề -->
    <Label alignment="CENTER" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" styleClass="main-title" stylesheets="@../../assets/tabel.css" text="Lịch sử đăng ký">
        <VBox.vgrow>NEVER</VBox.vgrow>
    </Label>

    <!-- TableView chiếm hết không gian còn lại -->
    <TableView fx:id="tableHistory" prefHeight="400" prefWidth="600" stylesheets="@../../assets/tabel.css" VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colTenSan" prefWidth="90" text="Tên Sân" />
            <TableColumn fx:id="colNgay" prefWidth="110" text="Ngày" />
            <TableColumn fx:id="colThoiGianBatDau" prefWidth="130" text="Thời Gian Bắt Đầu" />
            <TableColumn fx:id="colThoiGianKetThuc" prefWidth="130" text="Thời Gian Kết Thúc" />
            <TableColumn fx:id="colGiaLucDat" prefWidth="110" text="Giá Lúc Đặt" />
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
