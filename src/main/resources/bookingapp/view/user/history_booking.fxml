<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bookingapp.controller.user.HistoryBooking"
      spacing="20"
      style="-fx-background-color: #f9f9f9;"
      VBox.vgrow="ALWAYS">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- Tiêu đề -->
    <Label text="Lịch sử đăng ký"
           alignment="CENTER"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
        <VBox.vgrow>NEVER</VBox.vgrow>
    </Label>

    <!-- TableView chiếm hết không gian còn lại -->
    <TableView fx:id="tableHistory"
               VBox.vgrow="ALWAYS"
               prefHeight="400" prefWidth="600">

        <columns>
            <TableColumn fx:id="colTenSan" text="Tên Sân" prefWidth="90"/>
            <TableColumn fx:id="colNgay" text="Ngày" prefWidth="110"/>
            <TableColumn fx:id="colThoiGianBatDau" text="Thời Gian Bắt Đầu" prefWidth="130"/>
            <TableColumn fx:id="colThoiGianKetThuc" text="Thời Gian Kết Thúc" prefWidth="130"/>
            <TableColumn fx:id="colGiaLucDat" text="Giá Lúc Đặt" prefWidth="110"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>