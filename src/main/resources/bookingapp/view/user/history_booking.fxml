<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<VBox spacing="20" style="-fx-background-color: #f9f9f9;" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bookingapp.controller.user.HistoryBooking">

    <padding>
        <Insets bottom="30" left="40" right="40" top="30" />
    </padding>

    <!-- Tiêu đề và nút tìm kiếm trên cùng một dòng -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label alignment="CENTER"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
               text="Lịch sử đăng ký" />

        <Button fx:id="btnToggleSearch" text="🔍 Tìm kiếm"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"
                onAction="#onToggleSearchPanel" />
    </HBox>

    <!-- Panel tìm kiếm (ban đầu ẩn) -->
    <VBox fx:id="searchPanel" visible="false" managed="false" spacing="10"
          style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-background-radius: 8;"
          VBox.vgrow="NEVER">

        <Label text="Tìm kiếm lịch sử đặt sân" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

        <GridPane hgap="15" vgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" />
                <ColumnConstraints hgrow="SOMETIMES" />
            </columnConstraints>

            <Label text="Tên Sân:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <ComboBox fx:id="cbTenSan"
                      prefWidth="200"
                      editable="true"
                      promptText="Chọn hoặc nhập tên sân..."
                      GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Ngày Đặt Sân " GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <DatePicker fx:id="dpDate" GridPane.rowIndex="1" GridPane.columnIndex="1" />

        </GridPane>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Tìm kiếm" style="-fx-background-color: #27ae60; -fx-text-fill: white;"
                    onAction="#onSearch" />
            <Button text="Làm mới" style="-fx-background-color: #95a5a6;"
                    onAction="#onResetSearch" />
        </HBox>
    </VBox>

    <!-- Bảng lịch sử -->
    <TableView fx:id="tableHistory" prefHeight="400" prefWidth="600"
               stylesheets="@../../assets/tabel.css" VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colTenSan" prefWidth="90" text="Tên Sân" />
            <TableColumn fx:id="colNgay" prefWidth="110" text="Ngày" />
            <TableColumn fx:id="colThoiGianBatDau" prefWidth="130" text="Thời Gian Bắt Đầu" />
            <TableColumn fx:id="colThoiGianKetThuc" prefWidth="130" text="Thời Gian Kết Thúc" />
            <TableColumn fx:id="colGiaLucDat" prefWidth="110" text="Giá Lúc Đặt" />
            <TableColumn fx:id="colThaoTac" text="Thao tác" prefWidth="60" minWidth="60" maxWidth="80" sortable="false" />
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>