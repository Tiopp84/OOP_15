<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20" style="-fx-background-color: #f9f9f9;" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bookingapp.controller.user.PriceDetail">

    <padding>
        <Insets bottom="40" left="40" right="40" top="30" />
    </padding>

    <!-- Tiêu đề -->
    <HBox alignment="CENTER" spacing="10">
        <children>
            <Label alignment="CENTER" styleClass="main-title" stylesheets="@../../assets/tabel.css" text="Bảng giá chi tiết" HBox.hgrow="ALWAYS">
                <font>
                    <Font size="24.0" />
                </font>
            </Label>
        </children>
    </HBox>

    <!-- TableView chiếm hết không gian còn lại -->
    <TableView fx:id="priceDetailTable" prefHeight="400.0" prefWidth="600.0" stylesheets="@../../assets/tabel.css" VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="colDayStart" prefWidth="130" text="Từ" />
            <TableColumn fx:id="colDayEnd" prefWidth="130" text="Đến" />
            <TableColumn fx:id="colStartTime" prefWidth="110" text="Giờ Bắt Đầu" />
            <TableColumn fx:id="colEndTime" prefWidth="110" text="Giờ Kết Thúc" />
            <TableColumn fx:id="colPrice" prefWidth="120" text="Giá / giờ" />
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
