<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bookingapp.controller.user.PriceDetail"
      spacing="20"
      style="-fx-background-color: #f9f9f9;"
      VBox.vgrow="ALWAYS">

    <padding>
        <Insets top="30" right="40" bottom="40" left="40"/>
    </padding>

    <!-- Tiêu đề -->
    <HBox alignment="CENTER" spacing="10">
        <children>
            <Label text="Bảng giá chi tiết"
                   alignment="CENTER"
                   HBox.hgrow="ALWAYS">
                <font>
                    <Font size="24.0"/>
                </font>
            </Label>
        </children>
    </HBox>

    <!-- TableView chiếm hết không gian còn lại -->
    <TableView fx:id="priceDetailTable"
               VBox.vgrow="ALWAYS"
               prefHeight="400.0"
               prefWidth="600.0">

        <columns>
            <TableColumn fx:id="colDayStart"    text="Ngày Bắt Đầu"   prefWidth="130"/>
            <TableColumn fx:id="colDayEnd"      text="Ngày Kết Thúc"  prefWidth="130"/>
            <TableColumn fx:id="colStartTime"   text="Giờ Bắt Đầu"    prefWidth="110"/>
            <TableColumn fx:id="colEndTime"     text="Giờ Kết Thúc"   prefWidth="110"/>
            <TableColumn fx:id="colPrice"       text="Giá / giờ"      prefWidth="120"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>