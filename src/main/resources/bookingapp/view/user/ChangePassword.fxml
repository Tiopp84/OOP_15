<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bookingapp.controller.user.ChangePassword"
      alignment="CENTER"
      spacing="20.0"
      prefHeight="400.0"
      prefWidth="400.0"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="40" right="50" bottom="40" left="50"/>
    </padding>

    <!-- New Password -->
    <PasswordField promptText="Mật khẩu mới"
                   prefWidth="300.0"
                   prefHeight="45.0"
                   fx:id="newPassword"
                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d0d0d0; -fx-border-width: 1;"/>

    <!-- Confirm New Password -->
    <PasswordField promptText="Xác Nhận Mật Khẩu Mới"
                   prefWidth="300.0"
                   prefHeight="45.0"
                   fx:id="newConfirmPassword"
                   style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d0d0d0; -fx-border-width: 1;"/>

    <!-- Change Password Button -->
    <Button text="Xác nhận đổi mật khẩu"
            prefWidth="300.0"
            prefHeight="45.0"
            style="-fx-background-color: #4285f4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"
            onAction="#handleChangePassword"/>

</VBox>