<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="bookingapp.controller.admin.AdminMainController">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="200.0"
              style="-fx-background-color: #2F4F4F;"
              styleClass="sidebar"
              stylesheets="@../../assets/style.css"
              BorderPane.alignment="CENTER">

            <children>

                <!-- Quản lý người dùng -->
                <Button fx:id="bt_manageUsers"
                        onAction="#handleManageUsers"
                        maxWidth="1.7976931348623157E308"
                        text="Quản lý người dùng">
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Button>

                <!-- Quản lý sân -->
                <Button fx:id="bt_manageCourts"
                        onAction="#handleManageCourts"
                        maxWidth="1.7976931348623157E308"
                        text="Quản lý sân">
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Button>

                <!-- Quản lý đặt sân -->
                <Button fx:id="bt_manageBookings"
                        onAction="#handleManageBookings"
                        maxWidth="1.7976931348623157E308"
                        text="Quản lý đặt sân">
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Button>

                <!-- Quản lý giá -->
                <Button fx:id="bt_managePrice"
                        onAction="#handleManagePrice"
                        maxWidth="1.7976931348623157E308"
                        text="Quản lý giá">
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Button>

                <!-- Đăng xuất -->
                <Button fx:id="bt_logout"
                        onAction="#handleLogout"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        stylesheets="@../../assets/style.css"
                        text="Đăng xuất">
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Button>

            </children>

            <padding>
                <Insets top="15.0" />
            </padding>
        </VBox>
    </left>


    <top>
        <BorderPane prefHeight="65" style="-fx-background-color: #1C4535;">

            <left>
                <Label fx:id="Chaomung"
                       style="-fx-background-color: #444B4D;"
                       styleClass="text-field"
                       stylesheets="@../../assets/style.css"
                       textFill="#f7f7f7" underline="true">
                    <BorderPane.margin>
                        <Insets left="20.0" top="15.0" />
                    </BorderPane.margin>
                </Label>
            </left>

            <center>
                <Label text="Admin Dashboard" textFill="#fcfcfc">
                    <font>
                        <Font name="System Bold Italic" size="20.0" />
                    </font>
                </Label>
            </center>

        </BorderPane>
    </top>


    <center>
        <BorderPane fx:id="contentArea" />
    </center>

</BorderPane>
