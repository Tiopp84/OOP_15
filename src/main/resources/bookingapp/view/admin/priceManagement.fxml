<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bookingapp.controller.admin.PriceManagementController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Quản lý bảng giá" style="-fx-font-size: 18px; -fx-font-weight: bold"/>

    <TableView fx:id="table" prefHeight="300">
        <columns>
            <TableColumn fx:id="colId" text="Mã" prefWidth="60"/>
            <TableColumn fx:id="colStart_day" text="Ngày Bắt Đầu" prefWidth="120"/>
            <TableColumn fx:id="colEnd_day" text="Ngày Kết Thúc" prefWidth="120"/>
            <TableColumn fx:id="colStart" text="Bắt đầu" prefWidth="120"/>
            <TableColumn fx:id="colEnd" text="Kết thúc" prefWidth="120"/>
            <TableColumn fx:id="colPrice" text="Giá/giờ" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Thêm" onAction="#handleAdd"/>
        <Button text="Xóa" onAction="#handleDelete"/>
    </HBox>

</VBox>
