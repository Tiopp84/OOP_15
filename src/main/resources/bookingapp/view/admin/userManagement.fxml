<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bookingapp.controller.admin.UserManagementController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Quản lý người dùng"
           style="-fx-font-size: 18px; -fx-font-weight: bold"/>

    <!-- Thanh tìm kiếm nằm trên bảng -->
    <HBox spacing="10">
        <TextField fx:id="txtSearch" promptText="Tìm kiếm theo username / họ tên / sđt..." HBox.hgrow="ALWAYS"/>
        <Button text="Tìm" onAction="#handleSearch"/>
    </HBox>

    <TableView fx:id="tableUsers" prefHeight="360">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colUsername" text="Username" prefWidth="150"/>
            <TableColumn fx:id="colFullName" text="Họ tên" prefWidth="180"/>
            <TableColumn fx:id="colPhone" text="SĐT" prefWidth="140"/>
            <TableColumn fx:id="colRole" text="Role" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button fx:id="btnAdd" text="Thêm" onAction="#handleAddUser"/>
        <Button fx:id="btnDelete" text="Xóa" onAction="#handleDeleteUser"/>
        <Button fx:id="btnChangePassword" text="Đổi mật khẩu" onAction="#handleChangePassword"/>
    </HBox>

</VBox>
