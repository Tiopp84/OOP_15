<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bookingapp.controller.admin.CourtManagementController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Quản lý sân"
           style="-fx-font-size: 18px; -fx-font-weight: bold"/>

    <TableView fx:id="tableCourts" prefHeight="300">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
            <TableColumn fx:id="colName" text="Tên sân" prefWidth="200"/>
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Thêm sân" onAction="#handleAddCourt"/>
        <Button text="Xóa sân" onAction="#handleDeleteCourt"/>
        <Button text="Đổi trạng thái" onAction="#handleChangeStatus"/>
    </HBox>

</VBox>
