<?xml version="1.0" encoding="UTF-8"?>

<!--
  File FXML này phải nằm trong:
  src/main/resources/bookingapp/view/
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  1. Liên kết Controller: fx:controller="bookingapp.controller.RegisterController"
  2. Liên kết CSS: stylesheets="@../assets/style.css"
-->

<StackPane styleClass="root" stylesheets="@../assets/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bookingapp.controller.RegisterController">

    <!-- Khung VBox màu trắng chứa form đăng ký -->
    <VBox alignment="TOP_CENTER" maxHeight="500" maxWidth="350" spacing="15" styleClass="login-form-pane">

        <padding>
            <Insets bottom="30" left="40" right="40" top="30" />
        </padding>
        <Label styleClass="header-text" text="Tạo Tài Khoản Mới" />
      <Label text="Vui lòng điền đầy đủ thông tin phía dưới" textFill="#c12a2a" />

        <Label styleClass="form-label" text="Tên đăng nhập:" />
        <TextField fx:id="usernameField" promptText="Nhập tên của bạn" />
      <Label text=" Họ và tên:" />
      <TextField fx:id="fld_fullname" promptText="VD: Nguyễn Văn A" />
      <Label styleClass="form-label" text="Số điện thoại liên hệ" />
      <TextField fx:id="fld_phonenumber" promptText="VD: 0123456789" />

        <Label styleClass="form-label" text="Mật khẩu:" />
        <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu" />

        <Label styleClass="form-label" text="Xác nhận Mật khẩu:" />
        <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu" />

        <!-- HBox để chứa 2 nút (Đăng ký và Quay về) -->
        <HBox alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
            <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleRegister" styleClass="button" text="Đăng ký" HBox.hgrow="ALWAYS" />

            <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBackToLogin" styleClass="secondary-button" text="Quay về" HBox.hgrow="ALWAYS" />
        </HBox>

    </VBox>
</StackPane>
